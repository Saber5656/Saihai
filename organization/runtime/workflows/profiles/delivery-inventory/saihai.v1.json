{
  "inventory_version": "1",
  "repository": "Saber5656/Saihai",
  "source_digests": {
    ".github/workflows/codeql.yml": "e338b79ae6d2f5f23db254a2b385c0bc7c575142f2849c2f8c78fd8e20b759fc",
    ".github/workflows/validate.yml": "a891467d2461ee91cd3bac7bf01eabfd0ca3cff1535b11638283d6fb73ac634f"
  },
  "jobs": [
    {
      "cell_id": ".github/workflows/codeql.yml::analyze::{\"language\":\"actions\"}",
      "workflow_path": ".github/workflows/codeql.yml",
      "job_id": "analyze",
      "matrix": {
        "language": "actions"
      },
      "check_name": "Analyze (actions)",
      "contract": {
        "workflow": {
          "name": "CodeQL",
          "on": {
            "push": {
              "branches": [
                "main"
              ]
            },
            "pull_request": {
              "branches": [
                "main"
              ]
            },
            "schedule": [
              {
                "cron": "17 3 * * 1"
              }
            ],
            "workflow_dispatch": null
          },
          "permissions": {
            "contents": "read",
            "security-events": "write"
          }
        },
        "job": {
          "name": "Analyze (${{ matrix.language }})",
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 15,
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "language": [
                "actions",
                "python"
              ]
            }
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5"
            },
            {
              "name": "Initialize CodeQL",
              "uses": "github/codeql-action/init@99df26d4f13ea111d4ec1a7dddef6063f76b97e9",
              "with": {
                "languages": "${{ matrix.language }}"
              }
            },
            {
              "name": "Perform CodeQL analysis",
              "uses": "github/codeql-action/analyze@99df26d4f13ea111d4ec1a7dddef6063f76b97e9",
              "with": {
                "category": "/language:${{ matrix.language }}"
              }
            }
          ]
        }
      }
    },
    {
      "cell_id": ".github/workflows/codeql.yml::analyze::{\"language\":\"python\"}",
      "workflow_path": ".github/workflows/codeql.yml",
      "job_id": "analyze",
      "matrix": {
        "language": "python"
      },
      "check_name": "Analyze (python)",
      "contract": {
        "workflow": {
          "name": "CodeQL",
          "on": {
            "push": {
              "branches": [
                "main"
              ]
            },
            "pull_request": {
              "branches": [
                "main"
              ]
            },
            "schedule": [
              {
                "cron": "17 3 * * 1"
              }
            ],
            "workflow_dispatch": null
          },
          "permissions": {
            "contents": "read",
            "security-events": "write"
          }
        },
        "job": {
          "name": "Analyze (${{ matrix.language }})",
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 15,
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "language": [
                "actions",
                "python"
              ]
            }
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5"
            },
            {
              "name": "Initialize CodeQL",
              "uses": "github/codeql-action/init@99df26d4f13ea111d4ec1a7dddef6063f76b97e9",
              "with": {
                "languages": "${{ matrix.language }}"
              }
            },
            {
              "name": "Perform CodeQL analysis",
              "uses": "github/codeql-action/analyze@99df26d4f13ea111d4ec1a7dddef6063f76b97e9",
              "with": {
                "category": "/language:${{ matrix.language }}"
              }
            }
          ]
        }
      }
    },
    {
      "cell_id": ".github/workflows/validate.yml::validate::{}",
      "workflow_path": ".github/workflows/validate.yml",
      "job_id": "validate",
      "matrix": {},
      "check_name": "validate",
      "contract": {
        "workflow": {
          "name": "validate",
          "on": {
            "push": {
              "branches": [
                "main"
              ]
            },
            "pull_request": null,
            "merge_group": {
              "types": [
                "checks_requested"
              ]
            }
          },
          "concurrency": {
            "group": "${{ github.repository }}-${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}",
            "cancel-in-progress": false
          },
          "permissions": {
            "contents": "read"
          }
        },
        "job": {
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 10,
          "steps": [
            {
              "uses": "actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5"
            },
            {
              "uses": "actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065",
              "with": {
                "python-version": "3.11"
              }
            },
            {
              "name": "Run validation with verified native toolchain",
              "env": {
                "SAIHAI_ROOT": "${{ github.workspace }}",
                "AGENTS_VAULT_ROOT": "${{ runner.temp }}/agents-vault",
                "USER_VAULT_ROOT": "${{ runner.temp }}/user-vault",
                "SKILLS_REPO_ROOT": "${{ github.workspace }}",
                "SKILLS_ROOT": "${{ github.workspace }}/organization/roles",
                "DOTFILES_ROOT": "${{ github.workspace }}",
                "DEV_ROOT": "${{ runner.temp }}",
                "DEV_WORKTREES_ROOT": "${{ runner.temp }}/worktrees",
                "TASK_WORKTREE_ROOT": "${{ runner.temp }}/worktrees"
              },
              "run": "mkdir -p \"$AGENTS_VAULT_ROOT\" \"$USER_VAULT_ROOT\" \"$DEV_WORKTREES_ROOT\"\npython3 scripts/verify_delivery_toolchain.py --run full --output \"$RUNNER_TEMP/delivery-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT\"\n"
            },
            {
              "name": "Retain bounded validation evidence",
              "if": "always()",
              "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
              "with": {
                "name": "delivery-${{ github.run_id }}-${{ github.run_attempt }}",
                "path": "${{ runner.temp }}/delivery-${{ github.run_id }}-${{ github.run_attempt }}/receipt.json\n${{ runner.temp }}/delivery-${{ github.run_id }}-${{ github.run_attempt }}/validation.json\n",
                "retention-days": 14,
                "if-no-files-found": "error"
              }
            }
          ]
        }
      }
    }
  ],
  "lock_digests": {
    ".github/requirements-delivery.lock": "93a7e075703f062c614f47f65cc290fef319ec03ecc3bcba97685170d883151c",
    ".github/delivery-toolchain.lock.json": "805c029f4cd1939d82f511140b4d158a77075deb0da8285632bf1048a76769e8"
  }
}
