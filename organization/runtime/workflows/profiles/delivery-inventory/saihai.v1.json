{
  "inventory_version": "1",
  "repository": "Saber5656/Saihai",
  "source_digests": {
    ".github/workflows/codeql.yml": "c448662803d346e45567f38f3e31f4db79fc9c66df54b5b5fea801c89920e49e",
    ".github/workflows/validate.yml": "a891467d2461ee91cd3bac7bf01eabfd0ca3cff1535b11638283d6fb73ac634f"
  },
  "jobs": [
    {
      "cell_id": ".github/workflows/codeql.yml::analyze::{\"language\":\"actions\"}",
      "workflow_path": ".github/workflows/codeql.yml",
      "job_id": "analyze",
      "matrix": {
        "language": "actions"
      },
      "check_name": "Analyze (actions)",
      "contract": {
        "workflow": {
          "name": "CodeQL",
          "on": {
            "push": {
              "branches": [
                "main"
              ]
            },
            "pull_request": {
              "branches": [
                "main"
              ]
            },
            "schedule": [
              {
                "cron": "17 3 * * 1"
              }
            ],
            "workflow_dispatch": null,
            "merge_group": {
              "types": [
                "checks_requested"
              ]
            }
          },
          "concurrency": {
            "group": "${{ github.repository }}-${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}",
            "cancel-in-progress": false
          },
          "permissions": {
            "contents": "read"
          }
        },
        "job": {
          "permissions": {
            "contents": "read",
            "security-events": "write"
          },
          "name": "Analyze (${{ matrix.language }})",
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 15,
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "language": [
                "actions",
                "python"
              ]
            }
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5"
            },
            {
              "name": "Acquire and verify fixed CodeQL bundle",
              "env": {
                "LANGUAGE": "${{ matrix.language }}"
              },
              "run": "python3 scripts/verify_delivery_toolchain.py --codeql-phase acquire --bundle linux64 --language \"$LANGUAGE\" --output \"$RUNNER_TEMP/codeql-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$LANGUAGE\"\n"
            },
            {
              "name": "Initialize CodeQL",
              "id": "codeql-init",
              "uses": "github/codeql-action/init@99df26d4f13ea111d4ec1a7dddef6063f76b97e9",
              "with": {
                "languages": "${{ matrix.language }}",
                "tools": "${{ runner.temp }}/codeql-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.language }}/bundle.tar.gz",
                "trap-caching": "false",
                "dependency-caching": "false"
              }
            },
            {
              "name": "Verify initialized bundle and actual CLI version",
              "env": {
                "LANGUAGE": "${{ matrix.language }}",
                "CODEQL_PATH": "${{ steps.codeql-init.outputs.codeql-path }}",
                "CODEQL_VERSION": "${{ steps.codeql-init.outputs.codeql-version }}",
                "INIT_OUTCOME": "${{ steps.codeql-init.outcome }}"
              },
              "run": "python3 scripts/verify_delivery_toolchain.py --codeql-phase probe --bundle linux64 --language \"$LANGUAGE\" --output \"$RUNNER_TEMP/codeql-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$LANGUAGE\" --codeql-path \"$CODEQL_PATH\" --codeql-version \"$CODEQL_VERSION\" --init-outcome \"$INIT_OUTCOME\"\n"
            },
            {
              "name": "Perform CodeQL analysis",
              "id": "codeql-analysis",
              "uses": "github/codeql-action/analyze@99df26d4f13ea111d4ec1a7dddef6063f76b97e9",
              "with": {
                "category": "/language:${{ matrix.language }}",
                "output": "${{ runner.temp }}/codeql-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.language }}/results"
              }
            },
            {
              "name": "Record separate analysis and service observations",
              "if": "always()",
              "env": {
                "LANGUAGE": "${{ matrix.language }}",
                "INIT_OUTCOME": "${{ steps.codeql-init.outcome }}",
                "ANALYSIS_OUTCOME": "${{ steps.codeql-analysis.outcome }}",
                "SARIF_ID": "${{ steps.codeql-analysis.outputs.sarif-id }}"
              },
              "run": "python3 scripts/verify_delivery_toolchain.py --codeql-phase observe --bundle linux64 --language \"$LANGUAGE\" --output \"$RUNNER_TEMP/codeql-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT-$LANGUAGE\" --init-outcome \"$INIT_OUTCOME\" --analysis-outcome \"$ANALYSIS_OUTCOME\" --sarif-id \"$SARIF_ID\"\n"
            },
            {
              "name": "Retain bounded CodeQL phase receipts",
              "if": "always()",
              "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
              "with": {
                "name": "codeql-receipts-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.language }}",
                "path": "${{ runner.temp }}/codeql-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.language }}/receipt-acquire.json\n${{ runner.temp }}/codeql-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.language }}/receipt-probe.json\n${{ runner.temp }}/codeql-${{ github.run_id }}-${{ github.run_attempt }}-${{ matrix.language }}/receipt-observe.json\n",
                "retention-days": 14,
                "if-no-files-found": "error"
              }
            }
          ]
        }
      }
    },
    {
