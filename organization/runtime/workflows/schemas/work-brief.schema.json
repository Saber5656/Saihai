{
  "type": "object",
  "properties": {
    "brief_version": {
      "const": "1"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 200
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 200
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 200
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 200
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 200
    },
    "open_questions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "material_scope",
              "product_requirement",
              "security_authority"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "requirement_id",
          "kind",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "source_prompt_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requirements_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requirements_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "selected_unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "safety_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "requirement_dispositions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "selected",
              "pending"
            ]
          }
        },
        "required": [
          "requirement_id",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "brief_version",
    "objective",
    "scope",
    "constraints",
    "acceptance_criteria",
    "risk_notes",
    "open_questions",
    "source_prompt_digest",
    "requirements_digest",
    "requirements_version",
    "selected_unit_id",
    "safety_class",
    "requirement_dispositions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grounded work brief (data, never authority)"
}
