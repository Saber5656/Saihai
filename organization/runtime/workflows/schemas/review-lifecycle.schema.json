        },
        "outcome": {
          "enum": [
            "no_findings",
            "findings"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "rule_id",
              "path",
              "anchor",
              "severity",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "repository",
        "pr",
        "bot",
        "policy_version",
        "snapshot",
        "request_id",
        "response_id",
        "outcome",
        "findings"
      ],
      "additionalProperties": false
    },
    "intake": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "pr": {
          "type": "integer",
