        },
        "bot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "trigger_mode": {
          "enum": [
            "manual",
            "automatic_initial"
          ]
        },
        "original_snapshot": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "base": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "repository",
            "base",
            "head"
          ],
          "additionalProperties": false
        },
        "request_status": {
          "enum": [
            "planned",
            "unknown",
            "observed"
          ]
        },
        "request_candidate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/requestCandidate"
            }
          ]
        },
        "first_response_candidate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/responseCandidate"
            }
          ]
        },
        "later_response_candidates": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/responseCandidate"
          }
        },
        "authentication_status": {
          "const": "integration_pending"
        },
        "policy_status": {
          "const": "inactive"
        },
        "alternate": {
          "$ref": "#/$defs/alternate"
        }
      },
      "required": [
        "repository",
        "pr",
        "bot",
        "policy_version",
        "trigger_mode",
        "original_snapshot",
        "request_status",
        "request_candidate",
        "first_response_candidate",
